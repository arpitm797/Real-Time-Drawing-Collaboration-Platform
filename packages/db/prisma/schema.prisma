generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  rooms     Room[]
  createdAt DateTime @default(now())
}

model Room {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  adminId   Int
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
}